.idea
.Python
__pycache__
build/
develop-eggs/
dist/

# The upstream Python template ignores `.github`, but this repository *ships*
# CI workflows -- `publish.yml` was already tracked and `tests.yml` must be too.
# Git cannot re-include a file whose parent directory is excluded, so the rule
# has to exclude the directory's *contents* and then re-open `workflows/`.
# Ignore the editor and issue-template scaffolding; never the workflows.
.github/*
!.github/workflows/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

